# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value here is a PLACEHOLDER.
# Never commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Absolute origin. Required in production so gateways can build return URLs and
# reach the webhook routes. Locally you can leave it unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Revolut (Merchant API) ------------------------------------------------
# Business → Merchant API → API keys. Secret key, NOT the public one.
# Sandbox: https://sandbox-merchant.revolut.com/api
# Live:    https://merchant.revolut.com/api
REVOLUT_API_KEY=sk_placeholder_revolut_secret_key
REVOLUT_WEBHOOK_SECRET=wsk_placeholder_revolut_signing_secret
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com/api
REVOLUT_API_VERSION=2024-09-01

# --- PayMongo (GCash / Maya / cards) ---------------------------------------
# Dashboard → Developers → API keys. Test keys start sk_test_, live sk_live_.
# The webhook secret is returned once, when you create the webhook.
PAYMONGO_SECRET_KEY=sk_test_placeholder_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_placeholder_paymongo_webhook_secret
PAYMONGO_API_BASE=https://api.paymongo.com/v1

# --- HitPay (PayNow, incl. MariBank) ---------------------------------------
# Dashboard → Payment Gateway → API keys. The salt signs webhooks.
# Sandbox: https://api.sandbox.hit-pay.com/v1
# Live:    https://api.hit-pay.com/v1
HITPAY_API_KEY=placeholder_hitpay_api_key
HITPAY_WEBHOOK_SALT=placeholder_hitpay_salt
HITPAY_API_BASE=https://api.sandbox.hit-pay.com/v1

# --- Resend (the "email this draft to me" button) --------------------------
# resend.com → API Keys. Server-side only — never prefix this NEXT_PUBLIC_.
# Without it, /api/send-draft returns 503 and the button says so plainly.
RESEND_API_KEY=re_placeholder_resend_api_key
#
# Until you verify a domain in Resend, leave RESEND_FROM unset: the default
# onboarding@resend.dev only delivers to your own account address, which is a
# useful safety rail while the endpoint is public. Once a domain is verified:
# RESEND_FROM=Proposal Builder <proposals@your-domain.com>

# --- Order store -----------------------------------------------------------
# Dev only: where the JSON order cache lives. Unset in production, where you
# should swap lib/orders/store.ts for a real database (see README).
# ORDER_STORE_FILE=.data/orders.json
